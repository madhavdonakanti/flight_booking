# Django runtime
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=YOUR_RENDER_URL_HERE

# Frontend origins allowed to call backend API
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CORS_ALLOWED_ORIGINS=YOUR_VERCEL_URL_HERE
DJANGO_CORS_ALLOW_CREDENTIALS=false
DJANGO_CSRF_TRUSTED_ORIGINS=YOUR_VERCEL_URL_HERE

# Database
# For Supabase/PostgreSQL use your connection string here.
DATABASE_URL=YOUR_SUPABASE_URL_HERE
DJANGO_DB_SSL_REQUIRE=true
